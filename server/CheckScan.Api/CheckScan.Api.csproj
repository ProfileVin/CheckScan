<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- No <Version> here on purpose: `npm run publish:api` passes -p:Version=<electron/package.json
         version> so CheckScan.Api.exe always carries the same version as the installer. Dev builds
         (dotnet run/build) just use the SDK default 1.0.0. -->
    <Product>CheckScan API</Product>
    <Company>CheckScan</Company>
    <!-- Matches the working TwainTest reference project: the Epson TWAIN driver is 32-bit-only,
         and loading it into a 64-bit host process caused a native STATUS_STACK_BUFFER_OVERRUN
         crash during data transfer that no managed try/catch could intercept. -->
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <!-- Publish as a self-contained single file so the end user needs no separate .NET runtime;
       bundled into Electron's resources folder (see electron/package.json "build"). Stays win-x86
       to match PlatformTarget above. Only applied on `dotnet publish -p:PublishSingleFile=true`,
       so `dotnet run` in development is unaffected. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Never ship the developer's local appsettings.Development.json (may hold a plaintext
       connection string) inside a packaged build. -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Baked internal deployment: a gitignored appsettings.Production.json created on the build
       machine is published next to the exe (loaded automatically since the packaged app runs as
       Production) so a client install needs no manual configuration. The SDK's appsettings.*.json
       glob already copies it; this makes the intent explicit and the Exists() guard keeps
       build/publish working when the file is absent. See DEPLOYMENT.md. Internal builds only -
       the secrets ship in plaintext inside the installer. -->
  <ItemGroup Condition="Exists('appsettings.Production.json')">
    <Content Update="appsettings.Production.json" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.24.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="NTwain" Version="3.7.6" />

  </ItemGroup>

</Project>
